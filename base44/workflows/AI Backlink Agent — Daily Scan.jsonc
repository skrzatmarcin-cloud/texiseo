{
  "name": "AI Backlink Agent \u2014 Daily Scan",
  "description": "Codziennie o 8:00 agent AI wyszukuje nowe okazje backlink\u00f3w i generuje gotowe teksty SEO z linkiem do linguatoons.com",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ai_backlink_agent_daily_scan",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "backlinkAgent",
            "args": {
              "action": "daily_scan",
              "target_url": "https://linguatoons.com"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "backlinkAgent"
  }
}