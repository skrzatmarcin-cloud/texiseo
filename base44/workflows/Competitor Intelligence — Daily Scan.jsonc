{
  "name": "Competitor Intelligence \u2014 Daily Scan",
  "description": "Codziennie o 7:00 superagent analizuje wszystkich aktywnych konkurent\u00f3w \u2014 SEO, backlinki, freebies, webinary, AI visibility",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 4 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "competitor_intelligence_daily_scan",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "competitorAgent",
            "args": {
              "action": "daily_scan"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "competitorAgent"
  }
}